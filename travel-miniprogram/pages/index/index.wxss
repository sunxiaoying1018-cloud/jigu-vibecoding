page {
  background: linear-gradient(180deg, #DDF4FF 0%, #f7f8fa 28%, #f7f8fa 100%);
}

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #DDF4FF 0%, #f7f8fa 28%, #f7f8fa 100%);
}

.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  background: transparent;
}

.nav-inner {
  height: 88rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #22222A;
}

.nav-action {
  font-size: 26rpx;
  color: rgba(34, 34, 42, 0.52);
}

.content {
  height: 100vh;
  box-sizing: border-box;
}

.visited-summary {
  margin: 0 24rpx 18rpx;
  padding: 16rpx 0 0;
  border-top: 1rpx solid rgba(34, 34, 42, 0.08);
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.visited-label {
  flex-shrink: 0;
  font-size: 22rpx;
  color: rgba(34, 34, 42, 0.5);
  line-height: 32rpx;
}

.visited-text {
  flex: 1;
  font-size: 22rpx;
  color: rgba(34, 34, 42, 0.68);
  line-height: 32rpx;
}

.top-tabs-row {
  padding: 12rpx 24rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.day-tabs {
  flex: 1;
  min-width: 0;
  display: flex;
  gap: 12rpx;
  padding: 0;
  overflow-x: auto;
  white-space: nowrap;
}

.day-tab {
  width: 132rpx;
  min-height: 68rpx;
  padding: 8rpx 24rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: rgba(34, 34, 42, 0.06);
  color: rgba(34, 34, 42, 0.55);
  font-size: 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
  flex-shrink: 0;
}

.day-tab--active {
  background: #31AFFF;
  color: #FFFFFF;
}

.day-tab-title {
  font-size: 26rpx;
  font-weight: 600;
}

.day-tab-date {
  margin-top: 2rpx;
  font-size: 20rpx;
  opacity: 0.72;
}

.sort-toggle {
  width: 68rpx;
  height: 68rpx;
  border-radius: 999rpx;
  background: rgba(34, 34, 42, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sort-toggle-icon {
  width: 38rpx;
  height: 38rpx;
  flex-shrink: 0;
}

.day-section {
  padding: 0 24rpx 56rpx;
}

.group-card {
  margin-bottom: 20rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 34rpx rgba(34, 34, 42, 0.05);
}

.time-card {
  margin-bottom: 20rpx;
  padding: 0 28rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 34rpx rgba(34, 34, 42, 0.05);
}

.group-head {
  padding: 28rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.group-head-copy {
  flex: 1;
  min-width: 0;
}

.group-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.group-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #22222A;
  line-height: 44rpx;
  flex-shrink: 0;
}

.group-stars {
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-width: 0;
}

.group-star-icon {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

.group-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(34, 34, 42, 0.48);
  line-height: 34rpx;
}

.group-arrow {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f7f8fa;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform 160ms ease;
}

.group-arrow--open {
  transform: rotate(180deg);
}

.group-arrow-icon {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #22222A;
  border-bottom: 3rpx solid #22222A;
  transform: rotate(45deg) translate(-1rpx, -1rpx);
}

.item-list {
  padding: 0 28rpx 24rpx;
}

.trip-item {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid rgba(34, 34, 42, 0.07);
}

.check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(34, 34, 42, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 24rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.check--done {
  background: #FF44E6;
  border-color: #FF44E6;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.item-title {
  font-size: 30rpx;
  font-weight: 400;
  color: #22222A;
  line-height: 42rpx;
}

.item-title--done {
  color: #22222A;
}

.item-detail-toggle {
  width: 40rpx;
  height: 40rpx;
  margin-left: auto;
  border-radius: 50%;
  background: #f7f8fa;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform 160ms ease;
}

.item-detail-toggle--open {
  transform: rotate(180deg);
}

.item-detail-toggle-icon {
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid #22222A;
  border-bottom: 3rpx solid #22222A;
  transform: rotate(45deg) translate(-1rpx, -1rpx);
}

.item-hearts {
  display: flex;
  align-items: center;
  gap: 5rpx;
}

.item-heart-icon {
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
}

.item-tag {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 68, 230, 0.1);
  color: #FF44E6;
  font-size: 20rpx;
  line-height: 28rpx;
  flex-shrink: 0;
}

.item-time {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: rgba(34, 34, 42, 0.48);
  line-height: 36rpx;
}

.item-group {
  display: block;
  margin-top: 2rpx;
  font-size: 22rpx;
  color: rgba(34, 34, 42, 0.36);
  line-height: 32rpx;
}

.detail-box {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #f7f8fa;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.detail-row:last-child {
  margin-bottom: 0;
}

.detail-label {
  width: 96rpx;
  font-size: 22rpx;
  color: rgba(34, 34, 42, 0.42);
  line-height: 34rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

.detail-value {
  flex: 1;
  font-size: 24rpx;
  color: #22222A;
  line-height: 34rpx;
}

.photo-box {
  margin-top: 18rpx;
}

.photo-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.photo-item {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
}

.photo-thumb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
  background: #f7f8fa;
}

.photo-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(34, 34, 42, 0.78);
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 30rpx;
  text-align: center;
  font-weight: 500;
}

.photo-add {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(34, 34, 42, 0.06);
  color: rgba(34, 34, 42, 0.72);
  font-size: 24rpx;
  font-weight: 400;
}

.photo-add-icon {
  position: relative;
  width: 18rpx;
  height: 18rpx;
  flex-shrink: 0;
}

.photo-add-icon::before,
.photo-add-icon::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  background: rgba(34, 34, 42, 0.72);
  border-radius: 999rpx;
  transform: translate(-50%, -50%);
}

.photo-add-icon::before {
  width: 18rpx;
  height: 3rpx;
}

.photo-add-icon::after {
  width: 3rpx;
  height: 18rpx;
}
