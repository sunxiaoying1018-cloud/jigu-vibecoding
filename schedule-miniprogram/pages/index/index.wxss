page {
  height: 100vh;
  overflow: hidden;
  background: #ffffff;
  /* 设计稿：浅蓝底 */
  --accent-soft: rgba(49, 175, 255, 0.3);
  /* 设计稿：完成打勾、月/年「今天」圆点 */
  --accent-check: #31afff;
  --event-yellow: rgba(49, 175, 255, 0.3);
}

.page {
  height: 100vh;
  background: #ffffff;
}

.top-area {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  background: #ffffff;
  box-sizing: border-box;
}

.capsule-spacer {
  width: 100%;
}

.view-head-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 56rpx;
  padding: 0 32rpx 16rpx;
  box-sizing: border-box;
}

.view-head-row--scroll {
  flex-shrink: 0;
}

.view-head-text {
  font-size: 40rpx;
  font-weight: 600;
  color: #000000;
  line-height: 1.4;
}

.view-head-text--accent {
  color: var(--accent-check);
}

.view-head-badge {
  font-size: 22rpx;
  color: #000000;
  background: var(--accent-soft);
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  line-height: 1.4;
  flex-shrink: 0;
}

.body {
  height: 100vh;
  box-sizing: border-box;
}

.day-section {
  padding-bottom: 96rpx;
}

.day-section .view-head-row {
  padding-bottom: 24rpx;
}

.month-section {
  padding-bottom: 48rpx;
}

.month-layout {
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.month-task-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.year-section {
  padding-bottom: 80rpx;
}

.month-panel {
  padding: 0 10rpx;
}

.staff-filter {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 32rpx 18rpx;
  overflow-x: auto;
  white-space: nowrap;
  box-sizing: border-box;
}

.staff-filter--scroll {
  padding-top: 8rpx;
}

.staff-chip {
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(51, 51, 51, 0.08);
  color: rgba(51, 51, 51, 0.65);
  font-size: 24rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.staff-chip--active {
  background: rgba(49, 175, 255, 0.16);
  color: #000000;
  font-weight: 600;
}

.staff-chip-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.week-row {
  display: flex;
}

.week-cell {
  flex: 1;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.5);
}

.month-row {
  display: flex;
}

.month-cell {
  flex: 1;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.month-day-wrap {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.month-event-bg {
  position: absolute;
  top: 50%;
  height: 56rpx;
  background: var(--event-yellow);
  z-index: 0;
  transform: translateY(-50%);
}

.month-cell--muted .month-event-bg {
  opacity: 0.25;
}

.month-event-bg--single {
  left: 50%;
  width: 56rpx;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.month-event-bg--start {
  left: calc(50% - 28rpx);
  right: 0;
  border-radius: 999rpx 0 0 999rpx;
}

.month-event-bg--middle {
  left: 0;
  right: 0;
}

.month-event-bg--end {
  left: 0;
  right: calc(50% - 28rpx);
  border-radius: 0 999rpx 999rpx 0;
}

.month-day {
  font-size: 28rpx;
  font-weight: 400;
  color: #000000;
  line-height: 1.4;
}

.month-cell--muted .month-day {
  color: rgba(0, 0, 0, 0.25);
}

.month-cell--today .month-day-wrap {
  background: var(--accent-check);
  border-radius: 50%;
}

.month-cell--today .month-day {
  color: #ffffff;
  font-weight: 500;
}

.month-cell--selected:not(.month-cell--today) .month-day-wrap {
  background: rgba(51, 51, 51, 0.08);
  border-radius: 50%;
}

.month-cell--selected:not(.month-cell--today) .month-day {
  color: #000000;
  font-weight: 500;
}

.content-divider {
  height: 2rpx;
  background: rgba(0, 0, 0, 0.08);
  margin: 40rpx 32rpx 0;
}

.task-section {
  padding: 32rpx;
}

.task-section--inline {
  padding-top: 24rpx;
  padding-bottom: 16rpx;
}

.day-section .task-section--day {
  padding-top: 0;
  padding-bottom: 0;
}

.day-add-prompt {
  display: inline-flex;
  align-items: center;
}

.day-add-prompt--empty {
  gap: 8rpx;
  padding: 4rpx 0;
}

.day-add-prompt--inline {
  margin-top: 2rpx;
  padding-left: 0;
}

.day-add-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
  flex-shrink: 0;
}

.day-add-text {
  font-size: 28rpx;
  line-height: 40rpx;
}

.day-add-text--primary {
  color: var(--accent-check);
}

.quick-add-card {
  width: 100%;
  margin-top: 14rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.98);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
}

.quick-add-card--inline {
  margin-top: -26rpx;
}

.quick-title {
  height: 56rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #000000;
  padding: 0 0 16rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.quick-row {
  min-height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.quick-row--staff {
  align-items: flex-start;
  padding: 18rpx 0;
}

.quick-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #000000;
}

.quick-value {
  font-size: 26rpx;
  color: #000000;
}

.quick-value--placeholder {
  color: rgba(51, 51, 51, 0.35);
}

.quick-staff-list,
.form-staff-list {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  flex-wrap: wrap;
  max-width: 460rpx;
}

.quick-staff,
.form-staff {
  min-width: 44rpx;
  height: 44rpx;
  padding: 0 12rpx;
  border: 2rpx solid currentColor;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 42rpx;
  text-align: center;
  box-sizing: border-box;
}

.form-staff {
  min-width: 88rpx;
}

.quick-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 28rpx;
  padding-top: 20rpx;
}

.quick-cancel,
.quick-save {
  font-size: 28rpx;
  line-height: 40rpx;
}

.quick-cancel {
  color: rgba(0, 0, 0, 0.45);
}

.quick-save {
  color: var(--accent-check);
  font-weight: 600;
}

.day-scroll-spacer {
  height: 1200rpx;
}

.empty-tip--inline {
  padding: 24rpx 0;
}

.empty-tip-action {
  color: var(--accent-check);
}

.task-group {
  margin-bottom: 40rpx;
}

.task-group:last-child {
  margin-bottom: 0;
}

.task-time {
  font-size: 32rpx;
  font-weight: 600;
  color: #000000;
  line-height: 1.4;
  margin-bottom: 24rpx;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.task-list--day {
  gap: 36rpx;
}

.task-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.task-item--day {
  align-items: flex-start;
}

.task-check {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.task-item--day .task-check {
  margin-top: 2rpx;
}

.task-check-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.task-text {
  flex: 1;
  font-size: 28rpx;
  color: #000000;
  line-height: 1.4;
}

.task-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.task-text--day {
  flex: none;
  font-size: 32rpx;
  line-height: 44rpx;
}

.task-time-range {
  margin-top: 2rpx;
  font-size: 26rpx;
  color: rgba(51, 51, 51, 0.45);
  line-height: 36rpx;
}

.task-staff {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 500;
}

.task-staff--day {
  margin-top: 0;
}

.empty-tip {
  text-align: center;
  color: rgba(0, 0, 0, 0.35);
  font-size: 28rpx;
  padding: 80rpx 0;
}

.year-panel {
  box-sizing: border-box;
  padding: 8rpx 32rpx 0;
}

.year-grid {
  display: flex;
  flex-wrap: wrap;
  width: 686rpx;
  column-gap: 18rpx;
  row-gap: 40rpx;
}

.year-month {
  width: 216rpx;
  flex: 0 0 216rpx;
  height: 266rpx;
  box-sizing: border-box;
}

.year-month-title {
  height: 44rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #000000;
  line-height: 44rpx;
}

.year-month-title--current {
  color: var(--accent-check);
}

.year-date-grid {
  width: 216rpx;
  margin-top: 6rpx;
  height: 216rpx;
}

.year-date-row {
  display: flex;
  flex-direction: row;
  width: 216rpx;
  height: 36rpx;
}

.year-date-cell {
  flex: 0 0 30.857rpx;
  width: 30.857rpx;
  height: 36rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.year-date-cell--selected::after {
  content: "";
  position: absolute;
  inset: 2rpx;
  border: 2rpx solid rgba(49, 175, 255, 0.6);
  border-radius: 10rpx;
  z-index: 2;
  pointer-events: none;
}

.year-date-box {
  width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.year-event-bg {
  position: absolute;
  top: 50%;
  height: 28rpx;
  background: var(--event-yellow);
  z-index: 0;
  transform: translateY(-50%);
}

.year-event-bg--single {
  left: 50%;
  width: 28rpx;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.year-event-bg--start {
  left: calc(50% - 14rpx);
  right: 0;
  border-radius: 999rpx 0 0 999rpx;
}

.year-event-bg--middle {
  left: 0;
  right: 0;
}

.year-event-bg--end {
  left: 0;
  right: calc(50% - 14rpx);
  border-radius: 0 999rpx 999rpx 0;
}

.year-date-num {
  display: block;
  width: 100%;
  font-size: 20rpx;
  font-weight: 400;
  color: #000000;
  line-height: 28rpx;
  text-align: center;
  white-space: nowrap;
}

.year-date-box--today {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: var(--accent-check);
}

.year-date-box--today .year-date-num {
  color: #ffffff;
  font-weight: 500;
}

.year-staff-text {
  position: absolute;
  left: 50%;
  bottom: -4rpx;
  transform: translateX(-50%);
  max-width: 42rpx;
  font-size: 12rpx;
  line-height: 14rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.72);
  white-space: nowrap;
  z-index: 3;
}

.year-availability {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 170rpx;
  z-index: 28;
  padding: 22rpx 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.1);
  box-sizing: border-box;
}

.year-availability-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.year-availability-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #000000;
}

.year-availability-subtitle {
  font-size: 22rpx;
  color: rgba(51, 51, 51, 0.45);
}

.year-availability-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 12rpx;
}

.year-availability-label {
  width: 56rpx;
  font-size: 24rpx;
  line-height: 42rpx;
  color: rgba(51, 51, 51, 0.55);
  flex-shrink: 0;
}

.year-staff-tags {
  flex: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.year-staff-tag {
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 40rpx;
  box-sizing: border-box;
}

.year-staff-tag--booked {
  border: 2rpx solid currentColor;
  background: #ffffff;
}

.year-staff-tag--available {
  color: #ffffff;
}

.year-empty-staff {
  font-size: 22rpx;
  line-height: 42rpx;
  color: rgba(51, 51, 51, 0.35);
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 16rpx;
  z-index: 30;
  height: 144rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.bottom-segment {
  flex: 1;
  max-width: 478rpx;
  height: 80rpx;
  background: rgba(51, 51, 51, 0.08);
  border-radius: 999rpx;
  display: flex;
  padding: 6rpx;
  box-sizing: border-box;
}

.bottom-segment-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: rgba(51, 51, 51, 0.5);
  border-radius: 999rpx;
}

.bottom-segment-item--active {
  background: #ffffff;
  color: #000000;
  font-weight: 600;
  box-shadow: none;
}

.bottom-add {
  width: 216rpx;
  height: 84rpx;
  margin-left: 16rpx;
  background: var(--accent-soft);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.bottom-add-icon {
  font-size: 36rpx;
  font-weight: 300;
  color: #000000;
  line-height: 1;
}

.bottom-add-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #000000;
  line-height: 1.4;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: opacity 160ms ease;
}

.modal-mask--show {
  opacity: 1;
  pointer-events: auto;
}

.modal {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  height: 85vh;
  overflow: hidden;
  transform: translateY(100%);
  transition: transform 180ms ease;
  will-change: transform;
}

.modal-mask--show .modal {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.modal-cancel {
  font-size: 30rpx;
  color: rgba(0, 0, 0, 0.55);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
}

.modal-save {
  font-size: 30rpx;
  color: #000000;
  font-weight: 600;
}

.modal-body {
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  height: calc(85vh - 100rpx);
  overflow-y: auto;
  box-sizing: border-box;
}

.form-title {
  font-size: 36rpx;
  font-weight: 600;
  padding: 16rpx 0 32rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  margin-bottom: 8rpx;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.form-row--colors {
  align-items: flex-start;
}

.form-row--staff {
  align-items: flex-start;
}

.form-label {
  font-size: 28rpx;
  color: #000000;
}

.form-value {
  font-size: 28rpx;
  color: #000000;
}

.color-list {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
  max-width: 420rpx;
}

.color-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  box-sizing: border-box;
}

.color-dot--active {
  box-shadow: 0 0 0 4rpx #ffffff, 0 0 0 8rpx currentColor;
}

.form-notes {
  width: 100%;
  min-height: 120rpx;
  margin-top: 24rpx;
  padding: 20rpx;
  background: rgba(0, 0, 0, 0.04);
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.delete-btn {
  margin-top: 40rpx;
  text-align: center;
  color: #ff3b30;
  font-size: 30rpx;
  padding: 24rpx;
}
