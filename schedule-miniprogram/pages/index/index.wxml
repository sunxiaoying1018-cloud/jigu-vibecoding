<view class="page">
  <view
    class="top-area"
    style="padding-top: {{statusBarHeight}}px; padding-right: {{navRightPadding}}px;"
  >
    <view class="capsule-spacer" style="height: {{navBarHeight}}px;" />
    <view class="view-head-row" wx:if="{{view === 'month'}}" bindtap="goToday">
      <text class="view-head-text">{{headerTitle}}</text>
    </view>
  </view>

  <!-- 月视图：日历固定，仅选中日的日程可上下滑动 -->
  <block wx:if="{{view === 'month'}}">
    <view
      class="month-layout"
      style="padding-top: {{contentPaddingTop}}px; padding-bottom: {{bottomBarHeight}}px;"
    >
      <view class="staff-filter">
        <view class="staff-chip {{staffFilterId === 'all' ? 'staff-chip--active' : ''}}" data-staff="all" bindtap="onSelectStaffFilter">全部</view>
        <view
          class="staff-chip {{staffFilterId === item.id ? 'staff-chip--active' : ''}}"
          wx:for="{{staffOptions}}"
          wx:key="id"
          data-staff="{{item.id}}"
          bindtap="onSelectStaffFilter"
        >
          <text class="staff-chip-dot" style="background: {{item.color}};" />
          <text>{{item.name}}</text>
        </view>
      </view>
      <view
        class="month-panel"
        bindtouchstart="onTouchStart"
        bindtouchend="onTouchEnd"
      >
        <view class="week-row">
          <text class="week-cell" wx:for="{{weekLabels}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="month-grid">
          <view class="month-row" wx:for="{{monthRows}}" wx:for-item="row" wx:key="index">
            <view
              class="month-cell {{cell.inMonth ? '' : 'month-cell--muted'}} {{cell.isToday ? 'month-cell--today' : ''}} {{cell.isSelected ? 'month-cell--selected' : ''}}"
              wx:for="{{row}}"
              wx:for-item="cell"
              wx:key="date"
              data-date="{{cell.date}}"
              bindtap="onSelectDate"
            >
              <view
                wx:if="{{cell.hasEvent}}"
                style="background: {{cell.staffColor}};"
                class="month-event-bg {{cell.eventSingle ? 'month-event-bg--single' : ''}} {{cell.eventStart ? 'month-event-bg--start' : ''}} {{cell.eventMiddle ? 'month-event-bg--middle' : ''}} {{cell.eventEnd ? 'month-event-bg--end' : ''}}"
              />
              <view class="month-day-wrap">
                <text class="month-day">{{cell.day}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="content-divider" />
      <scroll-view
        scroll-y
        class="month-task-scroll"
        enhanced
        show-scrollbar="{{false}}"
      >
        <view class="task-section task-section--inline">
          <view wx:if="{{monthEventGroups.length === 0}}" class="empty-tip empty-tip--inline">
            <text>暂无日程，</text>
            <text class="empty-tip-action" bindtap="openAddModal">点击添加</text>
          </view>
          <view class="task-group" wx:for="{{monthEventGroups}}" wx:for-item="group" wx:key="time">
            <view class="task-time">{{group.time}}</view>
            <view class="task-list">
              <view class="task-item" wx:for="{{group.items}}" wx:for-item="task" wx:key="id">
                <view
                  class="task-check {{task.done ? 'task-check--done' : ''}}"
                  data-id="{{task.id}}"
                  catchtap="toggleDone"
                >
                  <image
                    class="task-check-icon"
                    src="{{task.done ? '/assets/icons/icon-check-blue.png' : '/assets/icons/icon-check-empty.png'}}"
                    mode="aspectFit"
                  />
                </view>
                <view class="task-content" data-id="{{task.id}}" bindtap="openEditModal">
                  <text class="task-text">{{task.title}}</text>
                  <text class="task-staff" style="color: {{task.staffColor}};">{{task.staffName}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </block>

  <scroll-view
    wx:if="{{view !== 'month'}}"
    scroll-y
    class="body"
    style="padding-top: {{contentPaddingTop}}px; padding-bottom: {{bottomBarHeight}}px;"
    scroll-into-view="{{scrollIntoView}}"
    scroll-top="{{scrollTop}}"
    scroll-with-animation="{{scrollWithAnimation}}"
    enhanced
    show-scrollbar="{{false}}"
    upper-threshold="120"
    lower-threshold="120"
    bindscroll="onBodyScroll"
    bindscrolltoupper="onReachTop"
    bindscrolltolower="onReachBottom"
    bindtap="closeQuickAdd"
  >
    <view class="staff-filter staff-filter--scroll">
      <view class="staff-chip {{staffFilterId === 'all' ? 'staff-chip--active' : ''}}" data-staff="all" bindtap="onSelectStaffFilter">全部</view>
      <view
        class="staff-chip {{staffFilterId === item.id ? 'staff-chip--active' : ''}}"
        wx:for="{{staffOptions}}"
        wx:key="id"
        data-staff="{{item.id}}"
        bindtap="onSelectStaffFilter"
      >
        <text class="staff-chip-dot" style="background: {{item.color}};" />
        <text>{{item.name}}</text>
      </view>
    </view>
    <!-- 日视图：默认今天置顶，日期标题随内容滚动 -->
    <block wx:if="{{view === 'day'}}">
      <view
        class="day-section"
        wx:for="{{daySections}}"
        wx:key="date"
        id="day{{item.scrollKey}}"
      >
        <view class="view-head-row view-head-row--scroll">
          <text class="view-head-text">{{item.title}}</text>
          <text class="view-head-badge" wx:if="{{item.isToday}}">今天</text>
        </view>
        <view class="task-section task-section--inline task-section--day">
          <view
            wx:if="{{item.events.length === 0}}"
            class="day-add-prompt day-add-prompt--empty"
            data-date="{{item.date}}"
            catchtap="openQuickAdd"
          >
            <image class="day-add-icon" src="/assets/icons/icon-add-blue.png" mode="aspectFit" />
            <text class="day-add-text day-add-text--primary">添加日程</text>
          </view>
          <view class="quick-add-card" wx:if="{{item.events.length === 0 && quickAddDate === item.date}}" catchtap="noop">
            <input
              class="quick-title"
              placeholder="添加标题"
              value="{{quickForm.title}}"
              data-field="title"
              bindinput="onQuickInput"
              focus="{{quickAddFocus}}"
              cursor-spacing="120"
              maxlength="40"
            />
            <view class="quick-row">
              <text class="quick-label">日期</text>
              <picker mode="date" value="{{quickForm.date}}" bindchange="onQuickPickDate">
                <text class="quick-value">{{quickForm.date}}</text>
              </picker>
            </view>
            <view class="quick-row quick-row--staff">
              <text class="quick-label">员工</text>
              <view class="quick-staff-list">
                <text
                  class="quick-staff {{quickForm.staffId === staff.id ? 'quick-staff--active' : ''}}"
                  wx:for="{{staffOptions}}"
                  wx:for-item="staff"
                  wx:key="id"
                  data-staff="{{staff.id}}"
                  style="border-color: {{staff.color}}; color: {{quickForm.staffId === staff.id ? '#ffffff' : staff.color}}; background: {{quickForm.staffId === staff.id ? staff.color : '#ffffff'}};"
                  bindtap="onQuickPickStaff"
                >{{staff.shortName}}</text>
              </view>
            </view>
            <view class="quick-row">
              <text class="quick-label">开始</text>
              <picker mode="time" value="{{quickForm.startTime}}" bindchange="onQuickPickStartTime">
                <text class="quick-value {{quickForm.startTime ? '' : 'quick-value--placeholder'}}">{{quickForm.startTime || '不填'}}</text>
              </picker>
            </view>
            <view class="quick-row">
              <text class="quick-label">结束</text>
              <picker mode="time" value="{{quickForm.endTime}}" bindchange="onQuickPickEndTime">
                <text class="quick-value {{quickForm.endTime ? '' : 'quick-value--placeholder'}}">{{quickForm.endTime || '不填'}}</text>
              </picker>
            </view>
            <view class="quick-actions">
              <text class="quick-cancel" bindtap="closeQuickAdd">取消</text>
              <text class="quick-save" bindtap="saveQuickEvent">保存</text>
            </view>
          </view>
          <view class="task-list task-list--day" wx:if="{{item.events.length > 0}}">
            <view class="task-item task-item--day" wx:for="{{item.events}}" wx:for-item="task" wx:key="id">
              <view
                class="task-check {{task.done ? 'task-check--done' : ''}}"
                data-id="{{task.id}}"
                catchtap="toggleDone"
              >
                <image
                  class="task-check-icon"
                  src="{{task.done ? '/assets/icons/icon-check-blue.png' : '/assets/icons/icon-check-empty.png'}}"
                  mode="aspectFit"
                />
              </view>
              <view class="task-content" data-id="{{task.id}}" bindtap="openEditModal">
                <text class="task-text task-text--day">{{task.title}}</text>
                <text class="task-staff task-staff--day" style="color: {{task.staffColor}};">{{task.staffName}}</text>
                <text class="task-time-range" wx:if="{{task.timeRange}}">{{task.timeRange}}</text>
              </view>
            </view>
            <view
              class="day-add-prompt day-add-prompt--inline"
              data-date="{{item.date}}"
              catchtap="openQuickAdd"
            >
              <image class="day-add-icon" src="/assets/icons/icon-add-gray.png" mode="aspectFit" />
            </view>
            <view class="quick-add-card quick-add-card--inline" wx:if="{{quickAddDate === item.date}}" catchtap="noop">
              <input
                class="quick-title"
                placeholder="添加标题"
                value="{{quickForm.title}}"
                data-field="title"
                bindinput="onQuickInput"
                focus="{{quickAddFocus}}"
                cursor-spacing="120"
                maxlength="40"
              />
              <view class="quick-row">
                <text class="quick-label">日期</text>
                <picker mode="date" value="{{quickForm.date}}" bindchange="onQuickPickDate">
                  <text class="quick-value">{{quickForm.date}}</text>
                </picker>
              </view>
              <view class="quick-row quick-row--staff">
                <text class="quick-label">员工</text>
                <view class="quick-staff-list">
                  <text
                    class="quick-staff {{quickForm.staffId === staff.id ? 'quick-staff--active' : ''}}"
                    wx:for="{{staffOptions}}"
                    wx:for-item="staff"
                    wx:key="id"
                    data-staff="{{staff.id}}"
                    style="border-color: {{staff.color}}; color: {{quickForm.staffId === staff.id ? '#ffffff' : staff.color}}; background: {{quickForm.staffId === staff.id ? staff.color : '#ffffff'}};"
                    bindtap="onQuickPickStaff"
                  >{{staff.shortName}}</text>
                </view>
              </view>
              <view class="quick-row">
                <text class="quick-label">开始</text>
                <picker mode="time" value="{{quickForm.startTime}}" bindchange="onQuickPickStartTime">
                  <text class="quick-value {{quickForm.startTime ? '' : 'quick-value--placeholder'}}">{{quickForm.startTime || '不填'}}</text>
                </picker>
              </view>
              <view class="quick-row">
                <text class="quick-label">结束</text>
                <picker mode="time" value="{{quickForm.endTime}}" bindchange="onQuickPickEndTime">
                  <text class="quick-value {{quickForm.endTime ? '' : 'quick-value--placeholder'}}">{{quickForm.endTime || '不填'}}</text>
                </picker>
              </view>
              <view class="quick-actions">
                <text class="quick-cancel" bindtap="closeQuickAdd">取消</text>
                <text class="quick-save" bindtap="saveQuickEvent">保存</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="day-scroll-spacer" />
    </block>

    <!-- 年视图：无限上下滑动 -->
    <block wx:if="{{view === 'year'}}">
      <view
        class="year-section"
        wx:for="{{yearSections}}"
        wx:key="year"
        id="year{{item.scrollKey}}"
      >
        <view class="view-head-row view-head-row--scroll">
          <text class="view-head-text {{item.isCurrentYear ? 'view-head-text--accent' : ''}}">{{item.label}}</text>
        </view>
        <view class="year-panel">
          <view class="year-grid">
            <view
              class="year-month"
              wx:for="{{item.yearMonths}}"
              wx:for-item="monthItem"
              wx:key="month"
              data-month="{{monthItem.month}}"
              data-year="{{item.year}}"
              bindtap="onSelectMonth"
            >
              <view class="year-month-title {{monthItem.isCurrentMonth ? 'year-month-title--current' : ''}}">{{monthItem.label}}</view>
              <view class="year-date-grid">
                <view
                  class="year-date-row"
                  wx:for="{{monthItem.rows}}"
                  wx:for-item="row"
                  wx:key="index"
                >
                  <view
                    class="year-date-cell {{cell && selectedYearDate === cell.date ? 'year-date-cell--selected' : ''}}"
                    wx:for="{{row}}"
                    wx:for-item="cell"
                    wx:for-index="colIdx"
                    wx:key="colIdx"
                    data-date="{{cell.date}}"
                    catchtap="onSelectYearDate"
                  >
                    <view
                      wx:if="{{cell && cell.hasEvent}}"
                      style="background: {{cell.staffColor}};"
                      class="year-event-bg {{cell.eventSingle ? 'year-event-bg--single' : ''}} {{cell.eventStart ? 'year-event-bg--start' : ''}} {{cell.eventMiddle ? 'year-event-bg--middle' : ''}} {{cell.eventEnd ? 'year-event-bg--end' : ''}}"
                    />
                    <view
                      class="year-date-box {{cell.isToday ? 'year-date-box--today' : ''}}"
                      wx:if="{{cell}}"
                    >
                      <text class="year-date-num">{{cell.day}}</text>
                    </view>
                    <text class="year-staff-text" wx:if="{{cell && cell.bookedStaffText}}">{{cell.bookedStaffText}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </scroll-view>

  <view class="year-availability" wx:if="{{view === 'year' && yearAvailability}}">
    <view class="year-availability-head">
      <text class="year-availability-title">{{yearAvailability.label}}</text>
      <text class="year-availability-subtitle">排班可用性</text>
    </view>
    <view class="year-availability-row">
      <text class="year-availability-label">已排</text>
      <view class="year-staff-tags">
        <text wx:if="{{yearAvailability.bookedStaffs.length === 0}}" class="year-empty-staff">暂无</text>
        <text
          class="year-staff-tag year-staff-tag--booked"
          wx:for="{{yearAvailability.bookedStaffs}}"
          wx:key="id"
          style="border-color: {{item.color}}; color: {{item.color}};"
        >{{item.name}}</text>
      </view>
    </view>
    <view class="year-availability-row">
      <text class="year-availability-label">可排</text>
      <view class="year-staff-tags">
        <text
          class="year-staff-tag year-staff-tag--available"
          wx:for="{{yearAvailability.availableStaffs}}"
          wx:key="id"
          style="background: {{item.color}};"
        >{{item.name}}</text>
      </view>
    </view>
  </view>

  <view class="bottom-bar" style="padding-bottom: env(safe-area-inset-bottom);">
    <view class="bottom-segment">
      <view
        class="bottom-segment-item {{view === 'day' ? 'bottom-segment-item--active' : ''}}"
        data-view="day"
        bindtap="switchView"
      >日</view>
      <view
        class="bottom-segment-item {{view === 'month' ? 'bottom-segment-item--active' : ''}}"
        data-view="month"
        bindtap="switchView"
      >月</view>
      <view
        class="bottom-segment-item {{view === 'year' ? 'bottom-segment-item--active' : ''}}"
        data-view="year"
        bindtap="switchView"
      >年</view>
    </view>
    <view class="bottom-add" bindtap="openAddModal">
      <text class="bottom-add-icon">+</text>
      <text class="bottom-add-text">日程</text>
    </view>
  </view>

  <view class="modal-mask {{showModal ? 'modal-mask--show' : ''}}" bindtap="closeModal">
    <view class="modal" catchtap="noop">
      <view class="modal-header">
        <text class="modal-cancel" bindtap="closeModal">取消</text>
        <text class="modal-title">{{editingId ? '编辑日程' : '新建日程'}}</text>
        <text class="modal-save" bindtap="saveEvent">保存</text>
      </view>
      <view class="modal-body">
        <input
          class="form-title"
          placeholder="添加标题"
          value="{{form.title}}"
          data-field="title"
          bindinput="onFormInput"
          maxlength="40"
        />
        <view class="form-row">
          <text class="form-label">日期</text>
          <picker mode="date" value="{{form.date}}" bindchange="onPickDate">
            <view class="form-value">{{form.date}}</view>
          </picker>
        </view>
        <view class="form-row form-row--staff">
          <text class="form-label">员工</text>
          <view class="form-staff-list">
            <text
              class="form-staff {{form.staffId === staff.id ? 'form-staff--active' : ''}}"
              wx:for="{{staffOptions}}"
              wx:for-item="staff"
              wx:key="id"
              data-staff="{{staff.id}}"
              style="border-color: {{staff.color}}; color: {{form.staffId === staff.id ? '#ffffff' : staff.color}}; background: {{form.staffId === staff.id ? staff.color : '#ffffff'}};"
              bindtap="onPickStaff"
            >{{staff.name}}</text>
          </view>
        </view>
        <view class="form-row">
          <text class="form-label">全天</text>
          <switch checked="{{form.allDay}}" bindchange="onToggleAllDay" color="rgba(49, 175, 255, 0.3)" />
        </view>
        <view class="form-row" wx:if="{{!form.allDay}}">
          <text class="form-label">开始</text>
          <picker mode="time" value="{{form.startTime}}" bindchange="onPickStartTime">
            <view class="form-value">{{form.startTime}}</view>
          </picker>
        </view>
        <view class="form-row" wx:if="{{!form.allDay}}">
          <text class="form-label">结束</text>
          <picker mode="time" value="{{form.endTime}}" bindchange="onPickEndTime">
            <view class="form-value">{{form.endTime}}</view>
          </picker>
        </view>
        <view class="form-row form-row--colors">
          <text class="form-label">颜色</text>
          <view class="color-list">
            <view
              class="color-dot {{form.color === item.value ? 'color-dot--active' : ''}}"
              wx:for="{{colorOptions}}"
              wx:key="id"
              style="background: {{item.value}};"
              data-color="{{item.value}}"
              bindtap="onPickColor"
            />
          </view>
        </view>
        <textarea
          class="form-notes"
          placeholder="备注（可选）"
          value="{{form.notes}}"
          data-field="notes"
          bindinput="onFormInput"
          maxlength="200"
          auto-height
        />
        <view class="delete-btn" wx:if="{{editingId}}" bindtap="deleteEvent">删除日程</view>
      </view>
    </view>
  </view>
</view>
