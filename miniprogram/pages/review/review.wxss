page {
  height: 100vh;
  overflow: hidden;
}

.review-page {
  height: 100vh;
  background: #ffffff;
  line-height: 1.5;
  overflow: hidden;
}

.review-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  background: #ffffff;
}

.review-nav-inner {
  position: relative;
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.nav-back {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  width: 48rpx;
  height: 48rpx;
}

.review-nav-title {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 34rpx;
  font-weight: 500;
  color: #333333;
  pointer-events: none;
}

.nav-side {
  width: 48rpx;
  height: 48rpx;
  margin-left: auto;
  flex-shrink: 0;
}

.review-scroll {
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
}

.review-body {
  box-sizing: border-box;
}

.quiz {
  position: relative;
  padding: 24rpx 64rpx 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: #ffffff;
}

.word-block {
  width: 100%;
}

.quiz-word {
  font-size: 52rpx;
  font-weight: 600;
  color: #333333;
  line-height: 78rpx;
  margin-bottom: 8rpx;
}

.quiz-meta {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 30rpx;
  font-weight: 400;
  color: #999999;
  line-height: 44rpx;
}

.speaker-hit {
  width: 88rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.speaker-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.tap-hint {
  position: absolute;
  top: 590rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 28rpx;
  color: #999999;
  line-height: 44rpx;
}

.answer-panel {
  margin-top: 16rpx;
}

.meaning-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-bottom: 40rpx;
}

.meaning-row {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 400;
  color: #333333;
  line-height: 42rpx;
}

.meaning-pos {
  flex-shrink: 0;
  font-weight: 400;
}

.meaning-text {
  flex: 1;
  font-weight: 400;
}

.detail-card {
  width: 686rpx;
  max-height: 530rpx;
  padding: 32rpx;
  margin-left: -32rpx;
  margin-right: -32rpx;
  border-radius: 28rpx;
  background: #f8f8fa;
  box-sizing: border-box;
  overflow: hidden;
}

.detail-card--long {
  overflow: hidden;
}

.detail-section + .detail-section {
  margin-top: 34rpx;
}

.detail-title {
  display: block;
  margin-bottom: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  line-height: 42rpx;
}

.detail-text {
  display: block;
  font-size: 28rpx;
  font-weight: 400;
  color: #333333;
  line-height: 42rpx;
}

.detail-text--sentence {
  display: block;
}

.source-highlight {
  color: #0095ff;
  font-weight: 400;
}

.detail-text--zh {
  margin-top: 8rpx;
  color: #666666;
}

.assess-row {
  position: absolute;
  left: 72rpx;
  right: 72rpx;
  bottom: calc(46rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-between;
}

.assess-btn {
  width: 144rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  background: transparent;
}

.assess-icon-bg {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.assess-btn--known .assess-icon-bg {
  background: #eaf8ff;
}

.assess-btn--vague .assess-icon-bg {
  background: #fff8e8;
}

.assess-btn--forgot .assess-icon-bg {
  background: #fff0f4;
}

.assess-icon {
  width: 96rpx;
  height: 96rpx;
  display: block;
}

.assess-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #333333;
  line-height: 34rpx;
}

.assess-btn--known .assess-title {
  color: #31afff;
}

.assess-btn--vague .assess-title {
  color: #f0a000;
}

.assess-btn--forgot .assess-title {
  color: #f05b6b;
}

.feedback {
  text-align: center;
  margin: 24rpx 0;
  color: #2c7a7b;
  font-weight: 600;
  line-height: 1.5;
}

.next-btn {
  width: 100%;
}

.done, .empty {
  text-align: center;
  padding: 64rpx 32rpx;
}

.done-emoji, .empty-emoji {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-mascot {
  width: 240rpx;
  height: 180rpx;
  margin: 0 auto 24rpx;
  display: block;
}

.done-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.done-stats {
  font-size: 28rpx;
  color: #2c7a7b;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.mascot-text {
  max-width: 520rpx;
  margin: 0 auto 40rpx;
  font-size: 28rpx;
  font-weight: 400;
  color: rgba(0, 0, 0, 0.5);
  line-height: 1.6;
}

.btn-primary {
  width: 320rpx;
  height: 88rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #31afff;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #ffffff;
  line-height: 88rpx;
}

.btn-primary::after {
  border: 0;
}
