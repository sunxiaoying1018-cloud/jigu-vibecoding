.finish-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
  line-height: 1.5;
}

.done-card {
  text-align: center;
  width: 100%;
  box-sizing: border-box;
}

.emoji {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2c7a7b;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.stats {
  margin-top: 24rpx;
  color: #999;
  font-size: 24rpx;
  line-height: 1.5;
}

.action-btn {
  width: 100%;
  margin-top: 24rpx;
}
