.articles-page {
  min-height: 100vh;
  background: #f8f8fa;
}

.articles-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  background: #ffffff;
}

.articles-nav-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}

.nav-back {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.nav-back-icon {
  width: 48rpx;
  height: 48rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 500;
  color: #000000;
}

.nav-side {
  width: 48rpx;
}

.articles-scroll {
  height: 100vh;
  box-sizing: border-box;
}

.articles-list {
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.article-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
}

.article-card-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.passage-id {
  font-size: 30rpx;
  font-weight: 400;
  color: #333333;
  line-height: 1.5;
}

.status-pill {
  font-size: 18rpx;
  font-weight: 400;
  line-height: 1.5;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.03);
  color: rgba(0, 0, 0, 0.5);
}

.status-pill--read {
  background: rgba(78, 146, 255, 0.1);
  color: #4e92ff;
}

.passage-title {
  display: block;
  font-size: 30rpx;
  font-weight: 400;
  color: #333333;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-pill {
  background: rgba(0, 0, 0, 0.03);
  border-radius: 8rpx;
  padding: 4rpx 8rpx;
  font-size: 18rpx;
  font-weight: 400;
  color: rgba(0, 0, 0, 0.5);
  line-height: 1.5;
}
