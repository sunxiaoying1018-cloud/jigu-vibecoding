/* Figma 144:1999 — 全部文章详情页，375px canvas，1px = 2rpx */

.articles-page {
  min-height: 100vh;
  background: #f8f8fa;
  line-height: 1.5;
}

.articles-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: transparent;
}

.articles-nav-status {
  width: 100%;
  background: transparent;
}

.articles-nav-inner {
  background: transparent;
  position: relative;
  display: flex;
  align-items: center;
  height: 88rpx;
  padding-left: 32rpx;
  box-sizing: border-box;
}

.nav-back {
  position: relative;
  z-index: 1;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  width: 48rpx;
  height: 48rpx;
}

/* 17px Medium #333 */
.nav-title {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 34rpx;
  font-weight: 500;
  color: #333333;
  line-height: 1.5;
  pointer-events: none;
}

.nav-side {
  flex-shrink: 0;
  height: 48rpx;
  margin-left: auto;
}

.articles-scroll {
  height: 100vh;
  box-sizing: border-box;
  background: #f8f8fa;
}

/* 列表区 y=100，左右 16px，卡片间距 12px */
.articles-list {
  padding: 0 32rpx calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.article-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.article-card-inner {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.article-card-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 42rpx;
}

/* 15px Regular #999 */
.passage-id {
  font-size: 30rpx;
  font-weight: 400;
  color: #999999;
  line-height: 1.5;
  white-space: nowrap;
}

/* 9px — 未阅读/未学习 */
.status-pill {
  font-size: 18rpx;
  font-weight: 400;
  line-height: 1.5;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.03);
  color: rgba(0, 0, 0, 0.5);
  white-space: nowrap;
}

/* 9px Medium — 已阅读 */
.status-pill--read {
  background: rgba(49, 175, 255, 0.05);
  color: #31afff;
  font-weight: 500;
}

/* 15px Regular #333，最多两行 */
.passage-title {
  font-size: 30rpx;
  font-weight: 400;
  color: #333333;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  max-height: 90rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-pill {
  background: rgba(0, 0, 0, 0.03);
  border-radius: 8rpx;
  padding: 4rpx 8rpx;
  font-size: 18rpx;
  font-weight: 400;
  color: rgba(0, 0, 0, 0.5);
  line-height: 1.5;
}

.tag-pill--exam {
  background: rgba(49, 175, 255, 0.1);
  color: #31afff;
}
