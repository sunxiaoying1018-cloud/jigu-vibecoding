.tank-page {
  min-height: 100vh;
  background: #ffffff;
  line-height: 1.5;
}

.tank-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  background: #ffffff;
}

.tank-nav-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tank-nav-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #000000;
}

.tank-scroll {
  height: 100vh;
  box-sizing: border-box;
}

.tank-body {
  padding: 24rpx 32rpx calc(104rpx + env(safe-area-inset-bottom) + 24rpx);
}

.empty-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 32rpx 64rpx;
}

.empty-mascot {
  width: 240rpx;
  height: 180rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.45);
  text-align: center;
  margin-bottom: 40rpx;
}

.empty-btn {
  height: 80rpx;
  padding: 0 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #bee6ff;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #000000;
}

.word-list {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

/* Figma 154:2753 — 左 150px 词+音标，右 180px 释义胶带 */
.word-row {
  display: flex;
  align-items: flex-start;
  gap: 26rpx;
  min-height: 80rpx;
}

.word-left {
  flex: 0 0 300rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.word-text {
  font-size: 30rpx;
  font-weight: 400;
  color: #4e92ff;
  line-height: 1.5;
  word-break: break-word;
}

.word-phonetic {
  font-size: 24rpx;
  font-weight: 400;
  color: rgba(0, 0, 0, 0.35);
  line-height: 1.4;
}

.meaning-right {
  position: relative;
  flex: 1;
  min-width: 0;
  min-height: 80rpx;
  display: flex;
  align-items: center;
}

.meaning-text {
  font-size: 26rpx;
  font-weight: 400;
  color: #333333;
  line-height: 1.5;
  width: 100%;
}

.meaning-right.is-revealed .meaning-text {
  color: #333333;
}

.tape-cover {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: stretch;
  padding: 0;
}

.tape-strip {
  position: relative;
  width: 100%;
  min-height: 80rpx;
  border-radius: 4rpx;
  background: linear-gradient(
    175deg,
    #d8f0ff 0%,
    #bee6ff 35%,
    #c8ebff 50%,
    #b0ddff 65%,
    #d0eeff 100%
  );
  box-shadow:
    0 2rpx 8rpx rgba(78, 146, 255, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  transform: rotate(-0.8deg);
  opacity: 0.98;
}

.tape-strip::before,
.tape-strip::after {
  content: "";
  position: absolute;
  top: -2rpx;
  bottom: -2rpx;
  width: 10rpx;
  background: #ffffff;
}

.tape-strip::before {
  left: -4rpx;
  clip-path: polygon(100% 0, 0 12%, 100% 28%, 0 44%, 100% 60%, 0 76%, 100% 92%, 0 100%);
}

.tape-strip::after {
  right: -4rpx;
  clip-path: polygon(0 0, 100% 10%, 0 26%, 100% 42%, 0 58%, 100% 74%, 0 90%, 100% 100%);
}
