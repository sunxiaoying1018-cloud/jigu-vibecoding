<view class="tank-page">
  <view class="tank-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="tank-nav-inner">
      <text class="tank-nav-title">抓小鱼单词</text>
    </view>
  </view>

  <scroll-view
    scroll-y
    class="tank-scroll"
    style="padding-top: {{navTotalHeight}}px;"
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="tank-body">
      <view wx:if="{{words.length === 0}}" class="empty-block">
        <image class="empty-mascot" src="/assets/ui/mascot.png" mode="aspectFit" />
        <text class="empty-text">{{emptyText}}</text>
        <view class="empty-btn" bindtap="goRead">去读文章</view>
      </view>

      <view wx:else class="word-list">
        <view class="word-row" wx:for="{{words}}" wx:key="key">
          <view class="word-left">
            <text class="word-text">{{item.word}}</text>
            <text class="word-phonetic" wx:if="{{item.phoneticDisplay}}">{{item.phoneticDisplay}}</text>
          </view>
          <view
            class="meaning-right {{item.revealed ? 'is-revealed' : ''}}"
            bindtap="onToggleMeaning"
            data-key="{{item.key}}"
          >
            <text class="meaning-text">{{item.meaningDisplay}}</text>
            <view class="tape-cover" wx:if="{{!item.revealed}}">
              <view class="tape-strip"></view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
