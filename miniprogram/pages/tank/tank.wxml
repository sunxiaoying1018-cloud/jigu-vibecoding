<view class="container">
  <view class="header">
    <view class="header-title">生词本</view>
    <view class="header-count">{{words.length}} 条</view>
  </view>

  <view wx:if="{{words.length === 0 && marks.length === 0}}" class="empty card">
    <view class="empty-emoji">🐱</view>
    <view class="mascot-text">{{emptyText}}</view>
    <button class="btn-primary" bindtap="goRead">去读文章</button>
  </view>

  <view wx:if="{{words.length > 0}}" class="word-list card">
    <block wx:for="{{words}}" wx:key="key">
      <view class="word-row">
        <view class="word-left">
          <view class="word-head">
            <text class="word-text">{{item.word}}</text>
            <view
              wx:if="{{item.articleId}}"
              class="word-go"
              catchtap="onGoSource"
              data-article-id="{{item.articleId}}"
              data-source-key="{{item.sourceKey}}"
            >›</view>
          </view>
          <text class="status status-{{item.status}}">{{item.statusLabel}}</text>
        </view>
        <view
          class="meaning-right {{item.revealed ? 'is-revealed' : ''}}"
          bindtap="onToggleMeaning"
          data-key="{{item.key}}"
        >
          <text class="meaning-text">{{item.meaning}}</text>
          <view class="tape-cover" wx:if="{{!item.revealed}}">
            <view class="tape-strip"></view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{marks.length > 0}}" class="marks-block card">
    <view class="marks-label">划线</view>
    <block wx:for="{{marks}}" wx:key="key">
      <view class="mark-line">{{item.text}}</view>
    </block>
  </view>
</view>
