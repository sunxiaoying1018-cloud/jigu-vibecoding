page {
  height: 100vh;
  overflow: hidden;
  background: #f8f8fa;
}

.mine-page {
  height: 100vh;
  background: #f8f8fa;
  position: relative;
  line-height: 1.5;
  overflow: hidden;
}

.mine-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  box-sizing: content-box;
}

.mine-nav-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mine-nav-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #000000;
  line-height: 1.5;
}

.mine-scroll {
  position: relative;
  z-index: 1;
  height: 100vh;
  box-sizing: border-box;
}

.mine-body {
  padding: 24rpx 32rpx calc(104rpx + 32rpx + env(safe-area-inset-bottom));
}

.mine-body .card {
  margin-bottom: 32rpx;
}

.stats-card {
  display: flex;
  justify-content: space-around;
  text-align: center;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.stage-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.accent-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.stage-label {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.45);
  line-height: 1.5;
}

.stage-name {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 500;
  color: #000000;
  line-height: 1.5;
}

.stage-desc {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.45);
  line-height: 1.5;
}

.stage-action {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #eef8ff;
  color: #31afff;
  font-size: 26rpx;
  font-weight: 500;
}

.accent-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #000000;
  line-height: 1.5;
}

.accent-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.45);
  line-height: 1.5;
}

.accent-options {
  flex-shrink: 0;
  display: flex;
  gap: 12rpx;
  margin-left: 20rpx;
}

.accent-option {
  min-width: 76rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8f8fa;
  color: rgba(0, 0, 0, 0.45);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 56rpx;
  box-sizing: border-box;
}

.accent-option--active {
  background: #eef8ff;
  color: #31afff;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 500;
  color: #333333;
  line-height: 1.5;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  line-height: 1.5;
}

.about-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.about-text {
  color: #666;
  line-height: 1.5;
  font-size: 26rpx;
}

.about-version {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #bbb;
  line-height: 1.5;
}

.clear-btn {
  width: 100%;
  height: 56rpx;
  padding: 0;
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: #ff3578;
  border: 0;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 56rpx;
  white-space: nowrap;
}

.clear-btn::after {
  border: 0;
}
