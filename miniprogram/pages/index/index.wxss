/* Figma 17:2133 — 375px canvas, 1px = 2rpx */

.home-page {
  height: 100vh;
  background: #f8f8fa;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  line-height: 1.5;
}

.home-header-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 532rpx;
  z-index: 0;
}

.home-nav {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 2;
  box-sizing: content-box;
}

.home-nav-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 17:2143 — Medium 17px, lineHeight 100% */
.home-nav-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #000000;
  line-height: 1.5;
}

/* 17:2216 — Regular 12px, 2 lines in 34px → 17px leading */
.home-greeting {
  position: absolute;
  left: 108rpx;
  z-index: 2;
}

.greeting-text {
  display: block;
  font-size: 24rpx;
  font-weight: 400;
  color: #000000;
  line-height: 1.5;
  white-space: pre-line;
}

/* 17:2214 — 120×90 at right */
.home-mascot {
  position: absolute;
  right: 0;
  width: 240rpx;
  height: 180rpx;
  z-index: 2;
}

.home-fixed-content {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  padding: 0 24rpx;
}

.home-all-section {
  position: relative;
  z-index: 1;
  flex: 1;
  min-height: 0;
  padding: 0 24rpx calc(24rpx + 104rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.error-banner {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: #fff0f0;
  border-radius: 16rpx;
}

.error-text {
  color: #e74c3c;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.5;
}

/* 17:2151 — top 136px, width 351px, padding 16px, radius 16px */
.today-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
}

/* 17:2154 — Medium 16px, box ~22px */
.section-label {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
  line-height: 1.5;
}

/* 17:2152 — flex col gap 4px */
.today-card-body {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

/* 17:2153 — label + 17:2155 (y=22, h=91) */
.today-section {
  display: flex;
  flex-direction: column;
}

/* 17:2155 — pt 12px, gap 8px, pb 12px */
.today-article-block {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx 0;
}

/* 17:2156 / 17:2170 — Regular 15px, leading-normal ≈ 21px (42rpx) */
.passage-title {
  display: block;
  font-size: 30rpx;
  font-weight: 400;
  color: #333333;
  line-height: 1.5;
}

.passage-title--list {
  word-break: break-word;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* 17:2159 — Regular 9px, lineHeight 100% */
.tag-pill {
  background: rgba(0, 0, 0, 0.03);
  border-radius: 8rpx;
  padding: 4rpx 8rpx;
  font-size: 18rpx;
  font-weight: 400;
  color: rgba(0, 0, 0, 0.5);
  line-height: 1.5;
}

/* 17:2164 — height 40px, text 14px Medium, py 10px */
.cta-btn {
  height: 80rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #bee6ff;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #000000;
  line-height: 1.5;
}

/* 17:2166 — 白色卡片，列表区域独立滚动 */
.all-card {
  height: 100%;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 36rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.all-scroll-host {
  flex: 1;
  height: 0;
  min-height: 0;
}

.all-list-scroll {
  width: 100%;
  box-sizing: border-box;
}

.list-scroll-inner {
  padding-bottom: 0;
}

/* 17:2167 → 17:2168 gap 2px */
.all-label {
  margin-bottom: 4rpx;
}

/* 17:2169 — py 12px, gap 8px */
.list-item {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx 0;
}

.list-item:last-child {
  padding-bottom: 0;
}
