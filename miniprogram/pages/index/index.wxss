.home-page {
  min-height: 100vh;
  background: #f8f8fa;
  position: relative;
  line-height: 1.5;
}

.home-header-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 532rpx;
  z-index: 0;
}

.home-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  box-sizing: content-box;
}

.home-nav-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-nav-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #000000;
  line-height: 1.5;
}

.home-scroll {
  position: relative;
  z-index: 1;
  height: 100vh;
  box-sizing: border-box;
}

.home-body {
  padding: 0 32rpx calc(104rpx + env(safe-area-inset-bottom) + 32rpx);
}

.error-banner {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: #fff0f0;
  border-radius: 16rpx;
}

.error-text {
  color: #e74c3c;
  font-size: 28rpx;
}

/* 状态条 — Figma 144:1957 */
.stats-card {
  display: flex;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx 40rpx 36rpx;
  margin-bottom: 16rpx;
}

.stat-col {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
  min-width: 0;
}

.stat-label {
  font-size: 24rpx;
  font-weight: 400;
  color: rgba(0, 0, 0, 0.5);
  line-height: 1.4;
  white-space: nowrap;
}

.stat-value-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 500;
  color: #000000;
  line-height: 1.2;
}

.stat-unit {
  font-size: 24rpx;
  font-weight: 400;
  color: rgba(0, 0, 0, 0.5);
  line-height: 1.4;
}

/* 今日阅读卡 — Figma 144:1974 */
.today-card {
  position: relative;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 16rpx;
  overflow: visible;
}

.today-mascot {
  position: absolute;
  top: -36rpx;
  right: 16rpx;
  width: 240rpx;
  height: 180rpx;
  z-index: 2;
  pointer-events: none;
}

.section-label {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
  line-height: 1.5;
  margin-bottom: 28rpx;
  padding-right: 200rpx;
}

.today-article-block {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.passage-id {
  display: block;
  font-size: 30rpx;
  font-weight: 400;
  color: #333333;
  line-height: 1.5;
}

.passage-title {
  display: block;
  font-size: 30rpx;
  font-weight: 400;
  color: #333333;
  line-height: 1.5;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-pill {
  background: rgba(0, 0, 0, 0.03);
  border-radius: 8rpx;
  padding: 4rpx 8rpx;
  font-size: 18rpx;
  font-weight: 400;
  color: rgba(0, 0, 0, 0.5);
  line-height: 1.5;
}

.cta-btn {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #bee6ff;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #000000;
}

/* 底部入口卡 — Figma 144:1990 / 144:2160 */
.bottom-cards {
  display: flex;
  gap: 30rpx;
}

.bottom-cards--split .action-card {
  flex: 1;
  min-width: 0;
}

.action-card {
  position: relative;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  min-height: 178rpx;
  box-sizing: border-box;
}

.action-card--full {
  width: 100%;
}

.action-arrow {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  font-size: 40rpx;
  font-weight: 300;
  color: rgba(0, 0, 0, 0.25);
  line-height: 1;
}

.action-title {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.action-sub {
  display: block;
  font-size: 26rpx;
  font-weight: 400;
  color: rgba(0, 0, 0, 0.45);
  line-height: 1.5;
}
