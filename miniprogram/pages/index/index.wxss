/* Figma 144:1926 / 144:2096 — 375px canvas, 1px = 2rpx */

page {
  height: 100vh;
  overflow: hidden;
  background: #f8f8fa;
}

.home-page {
  height: 100vh;
  background: #f8f8fa;
  position: relative;
  line-height: 1.5;
  overflow: hidden;
}

.home-header-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 360rpx;
  z-index: 0;
}

.home-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  box-sizing: content-box;
}

.home-nav-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 17:2143 — Medium 17px */
.home-nav-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #000000;
  line-height: 1.5;
}

/* 144:1988 — 120×90 at (255, 155) */
.home-mascot {
  position: fixed;
  right: 0;
  width: 240rpx;
  height: 180rpx;
  z-index: 5;
  pointer-events: none;
  display: block;
}

.home-scroll {
  position: relative;
  z-index: 1;
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
}

.home-body {
  padding: 0 32rpx calc(104rpx + env(safe-area-inset-bottom) + 32rpx);
}

.error-banner {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: #fff0f0;
  border-radius: 16rpx;
}

.error-text {
  color: #e74c3c;
  font-size: 28rpx;
}

/* 144:1958 — 343×82, radius 16px, content y=114 (18px inset) */
.stats-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  height: 164rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 36rpx 40rpx 0;
  margin-bottom: 32rpx;
  box-sizing: border-box;
}

.stat-col {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-width: 0;
}

.stat-col--left {
  flex: 0 0 120rpx;
}

.stat-col--center {
  flex: 0 0 120rpx;
  align-items: flex-start;
}

.stat-col--right {
  flex: 0 0 120rpx;
  align-items: flex-start;
}

/* 12px Regular #999 */
.stat-label {
  font-size: 24rpx;
  font-weight: 400;
  color: #999999;
  line-height: 1.5;
  white-space: nowrap;
}

.stat-value-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

/* 15px Medium #333 */
.stat-num {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  line-height: 1.5;
}

/* 12px Regular #333 */
.stat-unit {
  font-size: 24rpx;
  font-weight: 400;
  color: #333333;
  line-height: 1.5;
}

/* 144:1974 — 343×260, padding 16px, radius 16px */
.today-card {
  position: relative;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-sizing: border-box;
}

.action-card--full {
  width: 100%;
  margin-bottom: 32rpx;
}

.bottom-cards .action-card--full {
  margin-bottom: 0;
}

.today-card-inner {
  display: flex;
  flex-direction: column;
  gap: 56rpx;
}

/* 20px Medium */
.section-label {
  display: block;
  font-size: 40rpx;
  font-weight: 500;
  color: #000000;
  line-height: 1.5;
  padding-right: 200rpx;
}

.today-article-block {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 15px Regular #999 */
.passage-id {
  display: block;
  font-size: 30rpx;
  font-weight: 400;
  color: #999999;
  line-height: 1.5;
}

/* 15px Regular #333 */
.passage-title {
  display: block;
  font-size: 30rpx;
  font-weight: 400;
  color: #333333;
  line-height: 1.5;
}

.passage-title--multi {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  max-height: 90rpx;
}

.passage-title--single {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* 9px Regular */
.tag-pill {
  background: rgba(0, 0, 0, 0.03);
  border-radius: 8rpx;
  padding: 4rpx 8rpx;
  font-size: 18rpx;
  font-weight: 400;
  color: rgba(0, 0, 0, 0.5);
  line-height: 1.5;
}

.tag-pill--exam {
  background: rgba(49, 175, 255, 0.1);
  color: #31afff;
}

/* 144:1986 — #31AFFF, 48px, 16px white text, radius 12px */
.cta-btn {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #31afff;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #ffffff;
  line-height: 1.5;
}

/* 144:1990 / 144:2160 — gap 15px, height 89px */
.bottom-cards {
  display: flex;
  gap: 30rpx;
}

.bottom-cards--split .action-card {
  flex: 1;
  min-width: 0;
}

.action-card {
  position: relative;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  height: 178rpx;
  box-sizing: border-box;
}

.review-red-dot {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ff3578;
}

.bottom-cards .action-card {
  margin-bottom: 0;
}

/* 144:1994 — 24×24 grey chevron, y=43 in card */
.action-arrow {
  position: absolute;
  top: 50%;
  right: 20rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translateY(-50%);
}

.action-arrow::after {
  content: "";
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #bababd;
  border-right: 3rpx solid #bababd;
  transform: rotate(45deg);
  margin-left: -4rpx;
}

/* 20px Medium */
.action-title {
  display: block;
  font-size: 40rpx;
  font-weight: 500;
  color: #000000;
  line-height: 1.5;
  padding-right: 56rpx;
}

/* 14px Regular 50% opacity */
.action-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: 400;
  color: #000000;
  opacity: 0.5;
  line-height: 1.5;
}
