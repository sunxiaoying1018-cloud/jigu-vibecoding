<view class="home-page">
  <image class="home-header-bg" src="/assets/ui/header-bg.png" mode="widthFix" />

  <view class="home-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="home-nav-inner">
      <text class="home-nav-title">抓小鱼单词</text>
    </view>
  </view>

  <image
    class="home-mascot"
    src="{{mascotSrc}}"
    mode="aspectFit"
    style="top: {{mascotTop}}px;"
    binderror="onMascotError"
  />

  <scroll-view
    scroll-y="{{false}}"
    class="home-scroll"
    style="padding-top: {{navTotalHeight}}px;"
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="home-body" style="padding-top: {{bodyPaddingTop}}px;">
      <view class="error-banner" wx:if="{{loadError}}">
        <text class="error-text">{{loadError}}</text>
      </view>

      <view class="stats-card">
        <view class="stat-col stat-col--left">
          <text class="stat-label">已标记生词</text>
          <view class="stat-value-row">
            <text class="stat-num">{{markedCount}}</text>
            <text class="stat-unit">个</text>
          </view>
        </view>
        <view class="stat-col stat-col--center">
          <text class="stat-label">累计阅读</text>
          <view class="stat-value-row">
            <text class="stat-num">{{readCount}}</text>
            <text class="stat-unit">个</text>
          </view>
        </view>
        <view class="stat-col stat-col--right">
          <text class="stat-label">待复习单词</text>
          <view class="stat-value-row">
            <text class="stat-num">{{dueCount}}</text>
            <text class="stat-unit">个</text>
          </view>
        </view>
      </view>

      <view class="today-card {{showReviewCard ? 'today-card--compact' : ''}}" wx:if="{{todayArticle}}">
        <view class="today-card-inner">
          <text class="section-label">今日文章</text>

          <view class="today-article-block">
            <text class="passage-id">Passage {{todayArticle.id}}</text>
            <text class="passage-title {{showReviewCard ? 'passage-title--single' : 'passage-title--multi'}}">{{todayArticle.title}}</text>
            <view class="tag-row">
              <text class="tag-pill">{{todayArticle.topicTag}}</text>
              <text class="tag-pill">{{todayArticle.levelTag}}</text>
            </view>
          </view>

          <view class="cta-btn" catchtap="goReadToday">开始阅读</view>
        </view>
      </view>

      <view class="action-card action-card--full" bindtap="goTank">
        <view class="action-arrow" />
        <text class="action-title">生词本</text>
        <text class="action-sub">你标记过的单词都会被记录在这里哦</text>
      </view>

      <view class="bottom-cards {{showReviewCard ? 'bottom-cards--split' : ''}}">
        <view
          class="action-card"
          wx:if="{{showReviewCard}}"
          bindtap="goReview"
        >
          <view class="action-arrow" />
          <text class="action-title">复习单词</text>
          <text class="action-sub">待复习 {{dueCount}}/{{totalCaught}}</text>
        </view>
        <view
          class="action-card {{showReviewCard ? '' : 'action-card--full'}}"
          bindtap="goArticles"
        >
          <view class="action-arrow" />
          <text class="action-title">全部文章</text>
          <text class="action-sub">已阅读 {{readCount}}/{{totalArticles}}</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
