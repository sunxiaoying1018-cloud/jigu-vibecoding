page {
  min-height: 100vh;
  background: #f8f8fa;
}

.stage-page {
  min-height: 100vh;
  padding: 112rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.stage-header {
  margin-bottom: 48rpx;
  text-align: center;
}

.stage-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #000000;
  line-height: 1.4;
}

.stage-subtitle {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.5);
  line-height: 1.5;
}

.stage-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.stage-card {
  position: relative;
  min-height: 188rpx;
  padding: 36rpx 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.stage-card--selected {
  border-color: #31afff;
  background: #eef8ff;
}

.stage-check {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #31afff;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
}

.stage-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #000000;
  line-height: 1.5;
}

.stage-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.48);
  line-height: 1.5;
}

.stage-tip {
  margin-top: 32rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  color: rgba(0, 0, 0, 0.5);
  font-size: 24rpx;
  line-height: 1.5;
}

.stage-btn {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  height: 96rpx;
  border-radius: 28rpx;
  background: #31afff;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 96rpx;
}

.stage-btn::after {
  border: none;
}

.stage-btn--disabled {
  background: #cfd6df;
  color: #ffffff;
}
