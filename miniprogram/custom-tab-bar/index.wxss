.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  height: 104rpx;
  background: #ffffff;
  box-sizing: content-box;
  z-index: 9999;
}

.tab-bar--switching {
  pointer-events: none;
}

.tab-bar-border {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 1rpx;
  background: rgba(0, 0, 0, 0.05);
  transform: scaleY(0.5);
  transform-origin: 0 0;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 4rpx;
  min-width: 0;
  height: 104rpx;
}

.tab-icon {
  width: 36px;
  height: 36px;
  flex-shrink: 0;
  display: block;
}

.tab-text {
  margin-top: -4rpx;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.5;
  color: #8b8c91;
}

.tab-text--active {
  color: #31afff;
  font-weight: 500;
}
