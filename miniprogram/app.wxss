page {
  background-color: #f8f8fa;
  color: #000000;
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.container {
  padding: 0 32rpx 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(104rpx + 32rpx + env(safe-area-inset-bottom));
}

.card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.btn-primary {
  background: #bee6ff;
  color: #000000;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  padding: 0 48rpx;
  height: 80rpx;
  line-height: 1.5;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-primary::after {
  border: none;
}

.tag {
  display: inline-block;
  background: rgba(0, 0, 0, 0.03);
  color: rgba(0, 0, 0, 0.5);
  font-size: 18rpx;
  line-height: 1.5;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}

.mascot-text {
  color: rgba(0, 0, 0, 0.5);
  font-size: 26rpx;
  line-height: 1.5;
}

.mascot-name {
  color: #4e92ff;
  font-weight: 500;
}
