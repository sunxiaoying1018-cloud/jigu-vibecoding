page {
  background-color: #fff8f0;
  color: #2c3e50;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(44, 122, 123, 0.08);
}

.btn-primary {
  background: #4ecdc4;
  color: #ffffff;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 48rpx;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: #fff8f0;
  color: #2c7a7b;
  border: 2rpx solid #4ecdc4;
  border-radius: 48rpx;
  font-size: 28rpx;
  padding: 20rpx 40rpx;
}

.btn-secondary::after {
  border: none;
}

.tag {
  display: inline-block;
  background: #e8f8f7;
  color: #2c7a7b;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}

.mascot-text {
  color: #666;
  font-size: 26rpx;
  line-height: 1.8;
}

.mascot-name {
  color: #ff9f5a;
  font-weight: 600;
}
